# Flarum 2.0 运行环境变量示例
# 复制为 .env 后按需修改

# 必填：站点访问地址（需与反代/端口一致）
FLARUM_BASE_URL=http://localhost:8000

# 数据库（默认 MariaDB/MySQL，镜像内置 mariadb 客户端做连通性检测）
DB_HOST=db
DB_PORT=3306
DB_NAME=flarum
DB_USER=flarum
DB_PASSWORD=flarum
# DB_PREFIX=flarum_
# DB_NOPREFIX=false
# DB_TIMEOUT=60

# 可选：首次安装时的论坛标题
FLARUM_FORUM_TITLE=Flarum Dockerized

# 可选：调试模式
FLARUM_DEBUG=false

# 可选：时区 / 资源限制
TZ=UTC
MEMORY_LIMIT=256M
UPLOAD_MAX_SIZE=16M
OPCACHE_MEM_SIZE=128

# 可选：以非 root 用户运行
PUID=1000
PGID=1000

# 可选：sidecar 定时任务容器（另起一个同镜像容器并设 SIDECAR_CRON=1）
# SIDECAR_CRON=0
# CRON_SCHEDULE=* * * * *
